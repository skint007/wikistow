# Copy to .env for local development (`pnpm --filter @wikistow/server-app dev`).
# Services come from `docker compose up -d`.
DATABASE_URL=postgres://wikistow:wikistow@127.0.0.1:5433/wikistow
PUBLIC_ORIGIN=http://localhost:5173
PORT=3000
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Mailpit catches everything; read it at http://127.0.0.1:8025.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=WikiStow <wiki@localhost>
# Encrypted attachment files. Back it up together with the database.
BLOB_DIR=.data/blobs
# Largest attachment per upload, and attachment storage per account, in MiB.
MAX_UPLOAD_MIB=25
STORAGE_QUOTA_MIB=5120
# Spaces, folders and pages each account may create, including its agents' work.
# An item counts against the account that created it, even after it loses access.
# Deleting a folder or page frees room. Spaces can't be deleted yet, so the space
# limit counts every space the account has made.
MAX_SPACES_PER_ACCOUNT=100
MAX_FOLDERS_PER_ACCOUNT=10000
MAX_PAGES_PER_ACCOUNT=100000
# Days after a draft checkpoint is saved over before it may be removed (wikistow.md, Drafts and publication).
DRAFT_RETENTION_DAYS=30
# Only behind a proxy you control, which sets X-Real-IP.
TRUST_PROXY=false

# Wrong passwords an hour for one address before checks are refused for a while.
# Devices the owner signed in on keep their own allowance.
PASSWORD_GUESS_FAILURES=20

# The AI assistant (docs/operations.md, Connect an AI provider). Off unless the
# style, base URL and model are all set. The key stays on the server.
# AI_API_STYLE=openai            # openai (Chat Completions) or anthropic (Messages)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_MAX_OUTPUT_TOKENS=4096      # longest reply, in tokens
# AI_REQUESTS_PER_MINUTE=30      # per account; each tool step is a request
