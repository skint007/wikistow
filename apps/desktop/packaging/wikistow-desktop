#!/bin/sh
# Start WikiStow: on the Electron the .deb or .rpm bundles beside the app, or
# on Arch's system electron44. Installed as wikistow-desktop-beta, it starts
# the AUR's beta app, which sits beside the stable one in a folder of its
# own. Extra switches, one per line, can go in
# ~/.config/wikistow-desktop-flags.conf (wikistow-desktop-beta-flags.conf for
# the beta), such as `--password-store=basic` to keep nothing in the keyring
# (docs/desktop.md).
case "$(basename "$0")" in
  wikistow-desktop-beta) name=wikistow-desktop-beta ;;
  *) name=wikistow-desktop ;;
esac
flags="${XDG_CONFIG_HOME:-$HOME/.config}/$name-flags.conf"
if [ -r "$flags" ]; then
  # Word-split on purpose: one switch per line, no spaces inside a switch.
  # shellcheck disable=SC2046
  set -- $(grep -v '^[[:space:]]*#' "$flags") "$@"
fi
app=/usr/lib/$name
if [ -x "$app/$name" ]; then exec "$app/$name" "$@"; fi
exec electron44 "$app/app.asar" "$@"
