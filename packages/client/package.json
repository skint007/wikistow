{
  "name": "@wikistow/client",
  "version": "0.16.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/api/**",
    "./src/markdown/**",
    "./src/operations/**",
    "./src/*.ts",
    "./test/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/client.ts",
